# Linux-testomgeving voor s26u, zo dicht mogelijk bij de Actions-runner (ubuntu-latest, x86_64).
FROM --platform=linux/amd64 ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv curl ca-certificates git xz-utils \
 && curl -fsSL https://nodejs.org/dist/v22.11.0/node-v22.11.0-linux-x64.tar.xz | tar -xJ -C /usr/local --strip-components=1 \
 && rm -rf /var/lib/apt/lists/*
COPY requirements.txt /tmp/requirements.txt
RUN python3 -m pip install --quiet -r /tmp/requirements.txt && python3 -m playwright install --with-deps chromium
RUN git config --global --add safe.directory '*'
WORKDIR /repo
